{
  "name": "chenyu-dev",
  "version": "3.0.0",
  "description": "神针大学 陈屿 个人简历页（V3.0：Vite + TS + ESLint 工程化）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
